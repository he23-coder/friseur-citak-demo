---
import { Image } from 'astro:assets';
import logo from '@/assets/brand/logo.png';
import ThemeToggle from '@/components/ThemeToggle.astro';
import { services } from '@/data/services';
import { salons } from '@/data/site';

const path = Astro.url.pathname;
const isActive = (href: string) =>
  href === '/' ? path === '/' : path.startsWith(href);

const featuredServices = services.filter((s) => s.featured);
const mobileLinks = [
  { href: '/', label: 'Startseite' },
  { href: '/leistungen/', label: 'Leistungen' },
  { href: '/salons/', label: 'Salons' },
  { href: '/ueber-uns/', label: 'Über uns' },
  { href: '/kontakt/', label: 'Kontakt' },
];
---

<header class="site-header" id="site-header">
  <div class="header-shell">
    <div class="container header-inner">
      <a href="/" class="brand" aria-label="Hair Lounge by Citak – Startseite">
        <Image src={logo} alt="Hair Lounge by Citak & Co. – Logo" width={157} height={109} loading="eager" />
      </a>

      <nav class="main-nav" aria-label="Hauptnavigation">
        <ul>
          <li><a href="/" class="nav-link" aria-current={isActive('/') ? 'page' : undefined}>Startseite</a></li>
          <li class="nav-item--has-sub">
            <a href="/leistungen/" class="nav-link" aria-current={isActive('/leistungen/') ? 'page' : undefined}>Leistungen</a>
            <ul class="nav-sub">
              {featuredServices.map((s) => (
                <li><a href={`/leistungen/${s.slug}/`}>{s.name}</a></li>
              ))}
              <li><a href="/leistungen/"><strong>Alle Leistungen →</strong></a></li>
            </ul>
          </li>
          <li class="nav-item--has-sub">
            <a href="/salons/" class="nav-link" aria-current={isActive('/salons/') ? 'page' : undefined}>Salons</a>
            <ul class="nav-sub">
              {salons.map((s) => (
                <li><a href={`/salons/${s.id}/`}>{s.name}</a></li>
              ))}
            </ul>
          </li>
          <li><a href="/ueber-uns/" class="nav-link" aria-current={isActive('/ueber-uns/') ? 'page' : undefined}>Über uns</a></li>
          <li><a href="/kontakt/" class="nav-link" aria-current={isActive('/kontakt/') ? 'page' : undefined}>Kontakt</a></li>
        </ul>
      </nav>

      <div class="header-cta">
        <ThemeToggle />
        <a class="btn btn--accent btn--sm" href="/termin/">Termin vereinbaren</a>
      </div>

      <div class="header-mobile-actions">
        <ThemeToggle />
        <a class="btn btn--accent btn--mobile" href="/termin/">Termin</a>
      </div>
    </div>

    <nav class="mobile-primary-nav" aria-label="Mobile Hauptnavigation">
      <div class="container mobile-primary-nav__track">
        {mobileLinks.map((item) => (
          <a
            href={item.href}
            aria-current={isActive(item.href) ? 'page' : undefined}
          >
            {item.label}
          </a>
        ))}
      </div>
    </nav>
  </div>
</header>
