---
import { Image } from 'astro:assets';
import Base from '@/layouts/Base.astro';
import PageHero from '@/components/PageHero.astro';
import Icon from '@/components/Icon.astro';
import PriceTable from '@/components/PriceTable.astro';
import ReviewCarousel from '@/components/ReviewCarousel.astro';
import MapFacade from '@/components/MapFacade.astro';
import CTABand from '@/components/CTABand.astro';
import type { Salon } from '@/data/site';
import { salons } from '@/data/site';
import { team } from '@/data/team';
import type { SalonPrices } from '@/data/prices';

import stuehle from '@/assets/salon/stuehle.jpg';
import weinheimInnen from '@/assets/salon/weinheim-innen.jpg';
import empfang from '@/assets/salon/empfang.jpg';
import detail from '@/assets/salon/detail.jpg';
import leuchte from '@/assets/salon/leuchte.jpg';
import heroSalon from '@/assets/salon/hero.jpg';

interface Props {
  salon: Salon;
  prices: SalonPrices;
}

const { salon, prices } = Astro.props;
const other = salons.find((s) => s.id !== salon.id)!;
const members = team.filter((t) => t.salon === salon.id);

// Jede Filiale bekommt ihre eigene Bildwelt und Komposition
const heroImg = salon.id === 'mannheim' ? stuehle : weinheimInnen;
const secondImg = salon.id === 'mannheim' ? empfang : detail;
const thirdImg = salon.id === 'mannheim' ? heroSalon : leuchte;

const teamImages = import.meta.glob<{ default: ImageMetadata }>('/src/assets/team/*', { eager: true });
const teamImg = (name: string) => Object.entries(teamImages).find(([k]) => k.endsWith(`/${name}`))?.[1].default;

const siteUrl = Astro.site ?? new URL('https://friseur-citak-demo.geraldhe21.workers.dev');
const schema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Startseite', item: siteUrl.toString() },
    { '@type': 'ListItem', position: 2, name: 'Salons' },
    { '@type': 'ListItem', position: 3, name: salon.name },
  ],
};
---

<Base
  title={`Friseur ${salon.city} – ${salon.street} | Hair Lounge by Citak`}
  description={`Ihr Friseur in ${salon.city}: ${salon.name} der Hair Lounge by Citak, ${salon.street}, ${salon.zip}. ${salon.hours.map((h) => `${h.days} ${h.time}`).join(', ')}. Jetzt Termin vereinbaren!`}
  canonicalPath={`/salons/${salon.id}/`}
  schema={schema}
>
  <PageHero
    title={`${salon.name}`}
    lead="In unsere Räumlichkeiten einzutreten, bedeutet sich wie zu Hause zu fühlen."
    image={heroImg}
    imageAlt={`${salon.name} – Innenansicht`}
    flip={salon.id === 'weinheim'}
    crumbs={[{ label: 'Startseite', href: '/' }, { label: 'Salons' }, { label: salon.name }]}
  >
    <ul class="info-list mt-2" style="max-width:520px;">
      <li><Icon name="pin" size={16} /><span>{salon.street}, {salon.zip}{salon.district ? ` (${salon.district})` : ''}</span></li>
      {salon.hours.map((h) => (
        <li><Icon name="clock" size={16} /><span>{h.days} {h.time}</span></li>
      ))}
      <li><Icon name="phone" size={16} /><a href={salon.phoneHref} style="text-decoration:underline;">{salon.phoneDisplay}</a></li>
    </ul>
    <div class="btn-row mt-2">
      <a class="btn btn--accent" href={salon.bookingUrl} target="_blank" rel="noopener noreferrer">
        <Icon name="calendar" size={16} />
        Termin vereinbaren
      </a>
      <a class="btn btn--ghost" href={salon.googleMapsUrl} target="_blank" rel="noopener noreferrer">
        <Icon name="pin" size={16} />
        Route planen
      </a>
    </div>
  </PageHero>

  <section class="section--tight">
    <div class="container split">
      <div class="split__media rv rv-clip" style="aspect-ratio:16/10;overflow:hidden;">
        <Image src={secondImg} alt={`${salon.name} – Atmosphäre`} widths={[640, 960]} sizes="(max-width: 900px) 100vw, 50vw" loading="lazy" style="width:100%;height:100%;object-fit:cover;" />
      </div>
      <div class="rv" style="--d:.1s;">
        <h2>Ankommen und durchatmen</h2>
        <p class="lead">
          Authentisch, immer am Puls der Zeit und typgerecht: Wir perfektionieren Ihren Look und
          bringen ihn in Vollendung – mit persönlicher Beratung vor jeder Behandlung.
        </p>
        <ul class="list-line mt-2">
          <li><Icon name="check" size={15} />Zentrale Lage: {salon.street}, {salon.zip}</li>
          <li><Icon name="check" size={15} />Online-Terminbuchung rund um die Uhr</li>
          <li><Icon name="check" size={15} />{salon.googleRating.score.toLocaleString('de-DE')} von 5 Sternen bei Google ({salon.googleRating.count} Rezensionen)</li>
        </ul>
        <div class="btn-row mt-2">
          <a class="link-arrow" href={`/salons/${other.id}/`}>
            Auch in {other.city}: Zum {other.name}
            <Icon name="arrow" size={15} />
          </a>
        </div>
      </div>
    </div>
  </section>

  <section class="section section--sunk" id="team" aria-labelledby="team-heading">
    <div class="container">
      <div class="section-head rv">
        <p class="eyebrow">Unser Team in {salon.city}</p>
        <h2 id="team-heading">Menschen, die Ihr Handwerk lieben</h2>
        <p class="lead">
          Als junges, kreatives Team holen wir jeden Tag das Beste aus Ihnen heraus – mit
          regelmäßigen Weiterbildungen bei Wella und einem Ohr für alle Haarfragen.
        </p>
      </div>
      <div class="team-grid">
        {members.map((m, i) => (
          <div class={`team-tile rv ${m.photo ? '' : 'team-tile--placeholder'}`} style={`--d:${i * 0.06}s`}>
            <div class="team-tile__frame">
              {m.photo && teamImg(m.photo) ? (
                <Image src={teamImg(m.photo)!} alt={`${m.name} – Team ${salon.name}`} widths={[320, 480]} sizes="(max-width: 720px) 50vw, 25vw" loading="lazy" />
              ) : (
                <>
                  <span class="team-tile__initial" aria-hidden="true">{m.name.charAt(0)}</span>
                </>
              )}
            </div>
            <p class="team-tile__name">{m.name}</p>
            <p class="team-tile__salon">{salon.name}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section" id="preise" aria-labelledby="prices-heading">
    <div class="container">
      <div class="section-head rv">
        <h2 id="prices-heading">Transparente Preise im {salon.name}</h2>
      </div>
      <PriceTable prices={prices} />
      <div class="btn-row mt-2 rv">
        <a class="btn btn--accent" href={salon.bookingUrl} target="_blank" rel="noopener noreferrer">
          <Icon name="calendar" size={16} />
          Termin vereinbaren
        </a>
      </div>
    </div>
  </section>

  <ReviewCarousel salon={salon.id} heading={`Rezensionen zum Salon ${salon.city}`} />

  <section class="section" aria-labelledby="map-heading">
    <div class="container split">
      <div class="rv">
        <h2 id="map-heading">So finden Sie uns in {salon.city}</h2>
        <p class="lead">{salon.street}, {salon.zip}{salon.district ? ` – ${salon.district}` : ''}</p>
        <div class="btn-row mt-2">
          <a class="btn btn--ink" href={salon.googleMapsUrl} target="_blank" rel="noopener noreferrer">
            <Icon name="pin" size={16} />
            Route planen
          </a>
          <a class="btn btn--ghost" href={salon.phoneHref}>
            <Icon name="phone" size={16} />
            Anrufen
          </a>
        </div>
        <div class="split__media mt-3 rv rv-clip" style="aspect-ratio:16/10;overflow:hidden;">
          <Image src={thirdImg} alt={`${salon.name} – Impression`} widths={[640, 960]} sizes="(max-width: 900px) 100vw, 50vw" loading="lazy" style="width:100%;height:100%;object-fit:cover;" />
        </div>
      </div>
      <MapFacade salon={salon} />
    </div>
  </section>

  <CTABand
    title={`Ihr Termin im Salon ${salon.city}`}
    text={`Buchen Sie Ihren Termin im ${salon.name} bequem online – oder rufen Sie uns an: ${salon.phoneDisplay}. Wir freuen uns auf Sie!`}
  />
</Base>
