---
import { Image } from 'astro:assets';
import logo from '@/assets/brand/logo.png';
import Icon from '@/components/Icon.astro';
import { business, salons } from '@/data/site';
import { services } from '@/data/services';

const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container">
    <div class="footer-grid">
      <div class="footer-brand">
        <a href="/" aria-label="Hair Lounge by Citak – Startseite">
          <Image src={logo} alt="Hair Lounge by Citak & Co. – Logo" width={157} height={109} />
        </a>
        <p>
          Ihr Friseur in Mannheim und Weinheim – Familienunternehmen in zweiter Generation.
          Typgerechte Schnitte, Farbtechniken und Extensions auf höchstem Niveau.
        </p>
        <div class="footer-social">
          <a href={business.instagram} target="_blank" rel="noopener noreferrer" aria-label="Instagram">
            <Icon name="instagram" size={18} />
          </a>
          <a href={business.facebook} target="_blank" rel="noopener noreferrer" aria-label="Facebook">
            <Icon name="facebook" size={18} />
          </a>
          <a href={business.whatsapp} aria-label={`Telefon/WhatsApp: ${business.whatsappDisplay}`}>
            <Icon name="whatsapp" size={18} />
          </a>
        </div>
      </div>

      <div>
        <p class="footer-title">Leistungen</p>
        <ul class="footer-list">
          {services.slice(0, 7).map((s) => (
            <li><a href={`/leistungen/${s.slug}/`}>{s.name}</a></li>
          ))}
          <li><a href="/leistungen/"><strong>Alle Leistungen</strong></a></li>
        </ul>
      </div>

      {salons.map((salon) => (
        <div>
          <p class="footer-title">{salon.name}</p>
          <ul class="footer-list">
            <li>{salon.street}, {salon.zip}</li>
            {salon.hours.map((h) => (
              <li>{h.days} {h.time}</li>
            ))}
            <li><a href={salon.phoneHref}>{salon.phoneDisplay}</a></li>
            <li><a href={salon.bookingUrl} target="_blank" rel="noopener noreferrer"><strong>Termin vereinbaren</strong></a></li>
          </ul>
        </div>
      ))}
    </div>

    <div class="footer-bottom">
      <span>© {year} {business.name}. Alle Rechte vorbehalten.</span>
      <span>
        <a href="/impressum/">Impressum</a>
        &nbsp;·&nbsp;
        <a href="/datenschutz/">Datenschutz</a>
      </span>
    </div>
  </div>
</footer>
