---
import { Image } from 'astro:assets';
import Icon from '@/components/Icon.astro';
import type { Service } from '@/data/services';

interface Props {
  service: Service;
}

const { service } = Astro.props;
const images = import.meta.glob<{ default: ImageMetadata }>('/src/assets/services/*', { eager: true });
const img = Object.entries(images).find(([k]) => k.endsWith(`/${service.image}`))?.[1].default;
---

<article class="card service-card reveal">
  {img && (
    <div class="service-card__media">
      <Image src={img} alt={service.imageAlt} widths={[420, 640, 840]} sizes="(max-width: 640px) 100vw, (max-width: 1100px) 50vw, 33vw" loading="lazy" />
      <span class="service-card__cat">{service.category}</span>
    </div>
  )}
  <div class="service-card__body">
    <h3>{service.name}</h3>
    <p>{service.tagline}</p>
    <a class="link-arrow service-card__link" href={`/leistungen/${service.slug}/`} aria-label={`Mehr über ${service.name}`}>
      Mehr erfahren <Icon name="arrow" size={15} />
    </a>
  </div>
</article>
