---
import Icon from '@/components/Icon.astro';

const path = Astro.url.pathname;
const items = [
  { href: '/', label: 'Start', icon: 'heart' as const },
  { href: '/leistungen/', label: 'Leistungen', icon: 'scissors' as const },
  { href: '/termin/', label: 'Termin', icon: 'calendar' as const, primary: true },
  { href: '/salons/', label: 'Salons', icon: 'pin' as const },
  { href: '/kontakt/', label: 'Kontakt', icon: 'mail' as const },
];
const isActive = (href: string) =>
  href === '/' ? path === '/' : path.startsWith(href) || (href === '/salons/' && path.startsWith('/salons/'));
---

<nav class="sticky-bar" aria-label="Mobile Navigation">
  {items.map((item) => (
    <a
      href={item.href}
      class:list={[{ 'sticky-bar__primary': item.primary }]}
      aria-current={isActive(item.href) ? 'page' : undefined}
    >
      <Icon name={item.icon} size={19} />
      <span>{item.label}</span>
    </a>
  ))}
</nav>
