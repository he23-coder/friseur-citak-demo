---
import { Image } from 'astro:assets';
import Icon from '@/components/Icon.astro';
import type { Salon } from '@/data/site';

interface Props {
  salon: Salon;
}

const { salon } = Astro.props;

const images = import.meta.glob<{ default: ImageMetadata }>('/src/assets/salon/*', { eager: true });
const pick = (name: string) => Object.entries(images).find(([k]) => k.endsWith(`/${name}`))?.[1].default;
const img = pick(salon.id === 'mannheim' ? 'stuehle.jpg' : 'weinheim-innen.jpg');
---

<article class="salon-card reveal">
  {img && (
    <div class="salon-card__bg">
      <Image src={img} alt={`${salon.name} – Hair Lounge by Citak`} widths={[520, 840, 1100]} sizes="(max-width: 900px) 100vw, 50vw" loading="lazy" />
    </div>
  )}
  <div class="salon-card__body">
    <p class="eyebrow" style="color:var(--gold);">{salon.district ? `${salon.city} · ${salon.district}` : salon.city}</p>
    <h3>{salon.name}</h3>
    <div class="salon-card__meta">
      <div><Icon name="pin" size={15} /><span>{salon.street}, {salon.zip}</span></div>
      <div><Icon name="clock" size={15} /><span>{salon.hours.map((h) => `${h.days} ${h.time}`).join(' · ')}</span></div>
      <div><Icon name="star" size={15} /><span>{salon.googleRating.score.toLocaleString('de-DE')} · {salon.googleRating.count} Google-Rezensionen</span></div>
    </div>
    <div class="btn-row">
      <a class="btn btn--gold btn--sm" href={salon.bookingUrl} target="_blank" rel="noopener noreferrer">Termin buchen</a>
      <a class="btn btn--ghost-light btn--sm" href={`/salons/${salon.id}/`}>Salon entdecken</a>
    </div>
  </div>
</article>
