---
import '@fontsource-variable/playfair-display/wght.css';
import '@fontsource-variable/playfair-display/wght-italic.css';
import '@fontsource/manrope/400.css';
import '@fontsource/manrope/500.css';
import '@fontsource/manrope/600.css';
import '@fontsource/manrope/700.css';
import '@fontsource/manrope/800.css';
import '@/styles/global.css';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import StickyBar from '@/components/StickyBar.astro';
import { business, salons } from '@/data/site';

interface Props {
  title: string;
  description: string;
  canonicalPath?: string;
  ogImage?: string;
  schema?: object | object[];
}

const {
  title,
  description,
  canonicalPath = Astro.url.pathname,
  ogImage = '/og-image.jpg',
  schema,
} = Astro.props;

const siteUrl = Astro.site ?? new URL('https://friseur-citak-demo.geraldhe21.workers.dev');
const canonical = new URL(canonicalPath, siteUrl).toString();
const ogImageUrl = new URL(ogImage, siteUrl).toString();

// Schema: HairSalon ohne selbstreferenzielle Rezensions-Markierung.
// Die verifizierbare Quelle für Bewertungen ist das jeweilige Google-Profil (sameAs).
const orgSchema = {
  '@context': 'https://schema.org',
  '@graph': salons.map((s) => ({
    '@type': 'HairSalon',
    '@id': `${siteUrl}salons/${s.id}/#salon`,
    name: `${business.name} – ${s.name}`,
    url: `${siteUrl}salons/${s.id}/`,
    telephone: s.phoneDisplay,
    email: business.email,
    address: {
      '@type': 'PostalAddress',
      streetAddress: s.street,
      postalCode: s.zip.split(' ')[0],
      addressLocality: s.city,
      addressCountry: 'DE',
    },
    geo: { '@type': 'GeoCoordinates', latitude: s.geo.lat, longitude: s.geo.lng },
    openingHoursSpecification: s.hoursSchema.map((h) => ({
      '@type': 'OpeningHoursSpecification',
      dayOfWeek: h.dayOfWeek,
      opens: h.opens,
      closes: h.closes,
    })),
    sameAs: [business.instagram, business.facebook, s.googleMapsUrl],
  })),
};
---

<!doctype html>
<html lang="de">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#F5F0E6" id="meta-theme-color" />
    <script is:inline>
      // Theme vor dem ersten Paint anwenden (kein Flash)
      (function () {
        var KEY = 'hlc-theme';
        var stored = null;
        try {
          var param = new URLSearchParams(window.location.search).get('theme');
          if (param === 'light' || param === 'dark') { stored = param; }
          else { stored = localStorage.getItem(KEY); }
        } catch (e) {}
        var mode = stored === 'light' || stored === 'dark' || stored === 'system' ? stored : 'system';
        var prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
        var theme = mode === 'system' ? (prefersDark ? 'dark' : 'light') : mode;
        document.documentElement.dataset.theme = theme;
        document.documentElement.dataset.themeMode = mode;
        var meta = document.getElementById('meta-theme-color');
        if (meta) meta.setAttribute('content', theme === 'dark' ? '#16120D' : '#F5F0E6');
      })();
    </script>
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content="noindex, nofollow, noarchive" />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/favicon.svg" />

    <meta property="og:type" content="website" />
    <meta property="og:locale" content="de_DE" />
    <meta property="og:site_name" content={business.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImageUrl} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />

    <script type="application/ld+json" set:html={JSON.stringify(orgSchema)} is:inline />
    {schema && <script type="application/ld+json" set:html={JSON.stringify(schema)} is:inline />}
  </head>
  <body>
    <a class="skip-link" href="#main">Zum Inhalt springen</a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
    <StickyBar />
    <script>
      // Theme-Steuerung (Hell / Dunkel / System)
      (function () {
        var KEY = 'hlc-theme';
        var mq = window.matchMedia('(prefers-color-scheme: dark)');
        var metaTheme = document.getElementById('meta-theme-color');
        var COLORS: Record<string, string> = { light: '#F5F0E6', dark: '#16120D' };

        function currentMode() {
          return document.documentElement.dataset.themeMode || 'system';
        }
        function apply(mode: string, persist: boolean) {
          var theme = mode === 'system' ? (mq.matches ? 'dark' : 'light') : mode;
          document.documentElement.dataset.theme = theme;
          document.documentElement.dataset.themeMode = mode;
          if (persist) { try { localStorage.setItem(KEY, mode); } catch (e) {} }
          if (metaTheme) metaTheme.setAttribute('content', COLORS[theme]);
          document.querySelectorAll<HTMLButtonElement>('[data-theme-choice]').forEach(function (b) {
            b.setAttribute('aria-pressed', String(b.dataset.themeChoice === mode));
          });
        }
        document.querySelectorAll<HTMLButtonElement>('[data-theme-choice]').forEach(function (b) {
          b.addEventListener('click', function () { apply(b.dataset.themeChoice || 'system', true); });
        });
        mq.addEventListener('change', function () {
          if (currentMode() === 'system') apply('system', false);
        });
        apply(currentMode(), false);
        (window as any).__hlcTheme = { apply };
      })();

      // Reveal-on-scroll (.rv / .rv-left / .rv-clip)
      (function () {
        var prefersReduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        var els = document.querySelectorAll('.rv, .hero-e');
        if (prefersReduced || !('IntersectionObserver' in window)) {
          els.forEach(function (el) { el.classList.add('is-in'); });
          return;
        }
        var io = new IntersectionObserver(function (entries) {
          entries.forEach(function (e) {
            if (e.isIntersecting) {
              e.target.classList.add('is-in');
              io.unobserve(e.target);
            }
          });
        }, { threshold: 0.12, rootMargin: '0px 0px -6% 0px' });
        els.forEach(function (el) { io.observe(el); });
      })();

      // Header-Scrollzustand
      (function () {
        var header = document.querySelector('.site-header');
        function onScroll() {
          var y = window.scrollY;
          header?.classList.toggle('is-scrolled', y > 32);
        }
        window.addEventListener('scroll', onScroll, { passive: true });
        onScroll();
      })();

      // Sticky-Bar-Sichtbarkeit
      (function () {
        var bar = document.querySelector('.sticky-bar');
        function onScroll() { bar?.classList.toggle('is-visible', window.scrollY > 180); }
        window.addEventListener('scroll', onScroll, { passive: true });
        onScroll();
      })();
    </script>
  </body>
</html>
