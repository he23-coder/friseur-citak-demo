---
import { Image } from 'astro:assets';
import Base from '@/layouts/Base.astro';
import PageHero from '@/components/PageHero.astro';
import Icon from '@/components/Icon.astro';
import FAQ from '@/components/FAQ.astro';
import CTABand from '@/components/CTABand.astro';
import { services, getService } from '@/data/services';
import { salons, business } from '@/data/site';

export function getStaticPaths() {
  return services.map((s) => ({ params: { slug: s.slug } }));
}

const { slug } = Astro.params;
const service = getService(slug)!;

const images = import.meta.glob<{ default: ImageMetadata }>('/src/assets/services/*', { eager: true });
const pick = (name: string) => Object.entries(images).find(([k]) => k.endsWith(`/${name}`))?.[1].default;
const img = pick(service.image);
const vorher = pick('extensions-vorher.jpg');
const nachher = pick('extensions-nachher.jpg');

const related = service.related.map((r) => getService(r)).filter(Boolean);

// Zwei Kompositionen, alterniert nach Kategorie (kein Template-Look)
const colorCats = ['Farbe & Strähnen', 'Extensions'];
const composition = colorCats.includes(service.category) ? 'a' : 'b';

const siteUrl = Astro.site ?? new URL('https://friseur-citak-demo.geraldhe21.workers.dev');
const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'Service',
    name: service.name,
    description: service.metaDescription,
    provider: { '@type': 'HairSalon', name: business.name, url: siteUrl.toString() },
    areaServed: [
      { '@type': 'City', name: 'Mannheim' },
      { '@type': 'City', name: 'Weinheim' },
    ],
    url: new URL(`/leistungen/${service.slug}/`, siteUrl).toString(),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Startseite', item: siteUrl.toString() },
      { '@type': 'ListItem', position: 2, name: 'Leistungen', item: new URL('/leistungen/', siteUrl).toString() },
      { '@type': 'ListItem', position: 3, name: service.name },
    ],
  },
];
---

<Base
  title={service.metaTitle}
  description={service.metaDescription}
  canonicalPath={`/leistungen/${service.slug}/`}
  schema={schema}
>
  <PageHero
    eyebrow={service.category}
    title={service.name}
    lead={service.intro}
    image={composition === 'a' ? img : undefined}
    imageAlt={service.imageAlt}
    flip={composition === 'b' && !!img}
    crumbs={[
      { label: 'Startseite', href: '/' },
      { label: 'Leistungen', href: '/leistungen/' },
      { label: service.name },
    ]}
  >
    <div class="btn-row mt-2">
      <a class="btn btn--accent" href="/termin/">
        <Icon name="calendar" size={16} />
        Termin vereinbaren
      </a>
      <a class="btn btn--ghost" href="tel:+4962177735844">
        <Icon name="phone" size={16} />
        Beratung anfragen
      </a>
    </div>
  </PageHero>

  {composition === 'b' && img && (
    <div class="container">
      <div class="page-hero__media rv rv-clip" style="aspect-ratio:16/9;max-height:560px;">
        <Image src={img} alt={service.imageAlt} widths={[840, 1280, 1600]} sizes="100vw" loading="eager" />
      </div>
    </div>
  )}

  <section class="section">
    <div class="container split">
      <div class="rv">
        <h2>Was Sie erwartet</h2>
        {service.description.map((p) => <p class="muted">{p}</p>)}

        {service.slug === 'extensions' && vorher && nachher && (
          <div class="img-duo mt-3">
            <figure>
              <Image src={vorher} alt="Vor der Haarverlängerung mit Great Lengths" widths={[400, 560]} sizes="(max-width: 640px) 50vw, 25vw" loading="lazy" />
              <figcaption>Vorher</figcaption>
            </figure>
            <figure>
              <Image src={nachher} alt="Nach der Haarverlängerung: 75 Extensions in 40 cm" widths={[400, 560]} sizes="(max-width: 640px) 50vw, 25vw" loading="lazy" />
              <figcaption>Nachher · 75 Extensions, 40 cm</figcaption>
            </figure>
          </div>
        )}
      </div>
      <div class="rv" style="--d:.12s;">
        <div class="info-panel">
          <h3>Ihre Vorteile</h3>
          <ul class="list-line">
            {service.benefits.map((b) => (
              <li><Icon name="check" size={15} />{b}</li>
            ))}
          </ul>
          <p class="meta"><strong style="color:var(--ink);">Für wen geeignet?</strong><br />{service.audience}</p>
          <hr style="border:0;border-top:1px solid var(--line);margin:1.4rem 0;" />
          <p class="small muted mb-0">
            <strong style="color:var(--accent-deep);">15&nbsp;% Rabatt</strong> für Neukund:innen,
            Studierende, Azubis &amp; Schüler:innen – montags bis mittwochs
            {service.slug === 'extensions' ? ' (ausgenommen Extensions)' : ''}.
          </p>
        </div>
      </div>
    </div>
  </section>

  <section class="section--tight section--sunk">
    <div class="container split">
      <div class="rv">
        <h2 style="font-size:clamp(1.5rem,2.6vw,2rem);">Preise &amp; Buchung</h2>
        <p class="muted">
          Die aktuellen Preise für {service.name} finden Sie in den Preislisten unserer beiden
          Salons. Gern beraten wir Sie vorab persönlich.
        </p>
      </div>
      <div class="rv" style="--d:.1s;">
        <ul class="list-line">
          {salons.map((s) => (
            <li>
              <Icon name="pin" size={15} />
              <span>
                <a href={`/salons/${s.id}/#preise`} style="text-decoration:underline;">
                  Preisliste {s.name}
                </a>
                &nbsp;· {s.phoneDisplay}
              </span>
            </li>
          ))}
        </ul>
        <div class="btn-row mt-2">
          <a class="btn btn--accent btn--sm" href="/termin/">Termin vereinbaren</a>
        </div>
      </div>
    </div>
  </section>

  <FAQ items={service.faq} heading={`Häufige Fragen zu ${service.name}`} />

  <section class="section" aria-labelledby="related-heading">
    <div class="container">
      <div class="section-head rv">
        <h2 id="related-heading">Passt auch zu Ihnen</h2>
      </div>
      <ul class="svc-list rv">
        {related.map((r) => (
          <li class="svc-list__row">
            <a class="svc-list__link" href={`/leistungen/${r!.slug}/`}>
              <span class="svc-list__name">{r!.name}</span>
              <span class="svc-list__tag">{r!.tagline}</span>
              <Icon name="arrow" size={18} class="svc-list__arrow" />
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <CTABand
    title={`${service.name} in Mannheim oder Weinheim erleben`}
    text="Sichern Sie sich Ihren Wunschtermin – online in wenigen Klicks oder ganz persönlich am Telefon. Wir freuen uns auf Sie!"
  />
</Base>
