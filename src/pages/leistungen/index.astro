---
import Base from '@/layouts/Base.astro';
import PageHero from '@/components/PageHero.astro';
import Icon from '@/components/Icon.astro';
import { Image } from 'astro:assets';
import { services, categories } from '@/data/services';

const svcImages = import.meta.glob<{ default: ImageMetadata }>('/src/assets/services/*', { eager: true });
const svcImg = (file: string) => Object.entries(svcImages).find(([k]) => k.endsWith(`/${file}`))?.[1].default;

const catLead: Record<string, string> = {
  'Schnitt & Styling': 'Präzision, die zu Ihrem Typ passt – vom klassischen Façon bis zu modernen Beach Waves.',
  'Farbe & Strähnen': 'Von natürlichen Verläufen bis zur permanenten Coloration – mit Farbprodukten von Wella.',
  'Pflege & Extras': 'Intensivpflege und Details, die den Unterschied machen.',
  Extensions: 'Haarverlängerung und -verdichtung mit Ultraschall von Great Lengths.',
};
---

<Base
  title="Leistungen – Schnitt, Farbe, Styling & Extensions | Hair Lounge by Citak"
  description="Alle Leistungen der Hair Lounge by Citak: Damen- & Herrenhaarschnitt, Balayage, Babylights, Coloration, Glossing, Extensions u.v.m. – in Mannheim & Weinheim."
  canonicalPath="/leistungen/"
>
  <PageHero
    title="Alles für Ihr Haar"
    lead="Vierzehn Behandlungen, ein Anspruch: persönliche Beratung und Handwerk auf höchstem Niveau – in Mannheim und Weinheim."
    crumbs={[{ label: 'Startseite', href: '/' }, { label: 'Leistungen' }]}
  />

  <div class="container">
    {categories.map((cat) => {
      const items = services.filter((s) => s.category === cat);
      const cover = items[0] ? svcImg(items[0].image) : null;
      return (
        <section class="cat-block" aria-labelledby={`cat-${cat.replace(/[^a-z]/gi, '-')}`}>
          <div class="rv">
            <h2 id={`cat-${cat.replace(/[^a-z]/gi, '-')}`} class="display-lg">{cat}</h2>
            <p class="lead mt-1">{catLead[cat]}</p>
            {cover && (
              <div class="cat-block__media mt-2 rv rv-clip">
                <Image src={cover} alt={items[0].imageAlt} widths={[480, 720]} sizes="(max-width: 960px) 100vw, 33vw" loading="lazy" />
              </div>
            )}
          </div>
          <ul class="svc-list">
            {items.map((s) => (
              <li class="svc-list__row">
                <a class="svc-list__link" href={`/leistungen/${s.slug}/`}>
                  <span class="svc-list__name">{s.name}</span>
                  <span class="svc-list__tag">{s.tagline}</span>
                  <Icon name="arrow" size={18} class="svc-list__arrow" />
                </a>
              </li>
            ))}
          </ul>
        </section>
      );
    })}
  </div>

  <section class="section section--ink">
    <div class="container">
      <h2 class="rv">Nicht sicher, welche Leistung die richtige ist?</h2>
      <p class="lead rv" style="opacity:.8;">
        Rufen Sie uns an oder vereinbaren Sie einen Beratungstermin – gemeinsam finden wir die
        Behandlung, die zu Ihrem Haar und Ihren Wünschen passt.
      </p>
      <div class="btn-row mt-3 rv">
        <a class="btn btn--accent" href="/termin/">
          <Icon name="calendar" size={16} />
          Termin vereinbaren
        </a>
        <a class="btn btn--ghost-light" href="tel:+4962177735844">
          <Icon name="phone" size={16} />
          Anrufen
        </a>
      </div>
    </div>
  </section>
</Base>
