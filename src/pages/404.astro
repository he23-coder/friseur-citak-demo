---
import Base from '@/layouts/Base.astro';
import Icon from '@/components/Icon.astro';
---

<Base
  title="Seite nicht gefunden (404) | Hair Lounge by Citak"
  description="Diese Seite existiert leider nicht. Entdecken Sie unsere Leistungen oder vereinbaren Sie einen Termin."
  noindex={true}
>
  <section class="page-hero" style="min-height:70vh;display:flex;align-items:center;">
    <div class="container text-center">
      <p class="eyebrow" style="justify-content:center;">Fehler 404</p>
      <h1>Diese Seite wurde nicht gefunden</h1>
      <p class="lead" style="margin-inline:auto;">
        Vielleicht wurde die Seite verschoben – entdecken Sie stattdessen unsere Leistungen oder
        vereinbaren Sie direkt einen Termin.
      </p>
      <div class="btn-row mt-3" style="justify-content:center;">
        <a class="btn btn--gold" href="/">
          <Icon name="arrow" size={16} />
          Zur Startseite
        </a>
        <a class="btn btn--ghost-light" href="/leistungen/">Leistungen entdecken</a>
      </div>
    </div>
  </section>
</Base>
